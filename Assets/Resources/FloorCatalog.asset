  floors:
  - sceneName: Floor1
    title: PELATARAN BERINGIN
    lore: Dulu pelataran ini riuh oleh gamelan dan pedagang sekar. Kini akar beringin
      mencekik gapura, dan prajurit yang telah gugur masih berbaris menjaga tuan
      yang lama pergi.
    outdoor: 1
    water: 0
    floorTint: {r: 0.64, g: 0.69, b: 0.54, a: 1}
    wallTint: {r: 0.45882353, g: 0.52156866, b: 0.37254903, a: 1}
